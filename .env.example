# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: shared team data store.
# Real Supabase Auth (email+password) gates every table via RLS — the anon
# key alone can't read or write anything without a logged-in session.
# Get these from your Supabase project's Settings → API page.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# SUPABASE_SERVICE_ROLE_KEY: server-only secret used by api/team/create-member
# (and its local server.ts mirror) to create real Auth accounts for new team
# members. Bypasses RLS entirely — NEVER prefix this VITE_ (that would ship
# it to every browser) and NEVER commit a real value here. Get it from your
# Supabase project's Settings → API page ("service_role" key).
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# APPS_SCRIPT_URL: the deployed Google Apps Script web app URL (from
# src/data/googleAppsScript.ts, pasted into script.google.com — see
# Settings → Integrations for the setup guide). Server-only: api/appscript/proxy.ts
# (and its server.ts mirror) uses this so every teammate's image uploads and
# email reminders work without each person pasting their own copy into
# localStorage. Get the URL after Deploy → New deployment → Web app in the
# Apps Script editor.
APPS_SCRIPT_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

# BREVO_API_KEY: (optional) free-tier transactional email API from Brevo (sendinblue.com).
# 300 emails/day free — no credit card required.
# When set, email reminders are sent via Brevo directly (bypasses the Apps Script mailer path).
# Get your key at https://app.brevo.com/settings/keys/api
BREVO_API_KEY="xkeysib-YOUR_BREVO_KEY"
